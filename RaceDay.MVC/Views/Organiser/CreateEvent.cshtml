@model RaceDay.MVC.Models.CreateEventViewModel
@{
    ViewData["Title"] = "Create Event";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-body p-4">
                <h3 class="mb-4">Create New Event</h3>
                <form asp-action="CreateEvent" method="post">
                    <div asp-validation-summary="All" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="EventName" class="form-label">Event Name</label>
                        <input asp-for="EventName" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="mb-3">
                        <label asp-for="EventDate" class="form-label">Date</label>
                        <input asp-for="EventDate" class="form-control" type="date" />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Location" class="form-label">Location (City)</label>
                            <input asp-for="Location" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Venue" class="form-label">Venue</label>
                            <input asp-for="Venue" class="form-control" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="DistanceKm" class="form-label">Distance (km)</label>
                        <input asp-for="DistanceKm" class="form-control" type="number" step="0.1" />
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Create Event</button>
                </form>
            </div>
        </div>
    </div>
</div>