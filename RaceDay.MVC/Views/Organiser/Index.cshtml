@model List<RaceDay.MVC.Models.EventViewModel>
@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Organiser Dashboard</h2>
    <a asp-action="CreateEvent" class="btn btn-success">+ Create New Event</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">You haven't created any events yet.</div>
}
else
{
    <table class="table table-striped table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Event Name</th>
                <th>Date</th>
                <th>Location</th>
                <th>Distance</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ev in Model)
            {
                <tr>
                    <td>@ev.EventName</td>
                    <td>@ev.EventDate.ToString("yyyy-MM-dd")</td>
                    <td>@ev.Location</td>
                    <td>@ev.DistanceKm km</td>
                </tr>
            }
        </tbody>
    </table>
}